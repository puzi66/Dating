# Copy to .env (never commit it) or set these in the hosting dashboard.

# production | development. In production SECRET_KEY is mandatory and cookies are Secure.
APP_ENV=development

# Long random string used to sign session cookies:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Admin console (/admin) HTTP basic auth. Admin is disabled until both are set.
ADMIN_USER=team
ADMIN_PASSWORD=

# Public URL of the app, used to build the personal invite links (no trailing slash).
BASE_URL=http://localhost:8000

# Database. Default: SQLite at ./data/app.db. On Render, the managed Postgres URL is injected.
# DATABASE_URL=postgresql://user:pass@host:5432/shalosh

# Where photos are stored (local disk; use a persistent disk in production).
# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=8

# Claude. Without a key the app runs with a scripted fake עדי (FAKE_LLM=1 forces it).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Server-side refusal fallback (beta). Set to 0 if the API ever rejects it.
CLAUDE_FALLBACKS=1
FAKE_LLM=0

# Set to 1 when served over HTTPS (default on in production).
# COOKIE_SECURE=1
